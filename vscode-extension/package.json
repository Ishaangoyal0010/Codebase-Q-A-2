{
  "name": "codebase-qa-extension",
  "displayName": "Codebase Q&A",
  "description": "Index and ask questions about your local workspace files using serverless Hugging Face & Groq APIs.",
  "version": "1.0.0",
  "publisher": "ishaan",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codebase-qa-sidebar",
          "title": "Codebase Q&A",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codebase-qa-sidebar": [
        {
          "id": "codebase-qa.chatView",
          "type": "webview",
          "name": "Codebase Q&A Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "codebase-qa.setKeys",
        "title": "Codebase Q&A: Configure API Keys"
      },
      {
        "command": "codebase-qa.clearIndex",
        "title": "Codebase Q&A: Clear Workspace Index"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^16.11.7",
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.4"
  }
}
